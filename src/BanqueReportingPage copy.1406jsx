import { useEffect, useMemo, useState } from "react";
import { supabase } from "./supabaseClient";

export default function BanqueReportingPage() {
  const [session, setSession] = useState(null);
  const [email, setEmail] = useState("contact@tibaldo.fr");
  const [password, setPassword] = useState("");
  const [lines, setLines] = useState([]);
  const [message, setMessage] = useState("");
  const [categoryFilter, setCategoryFilter] = useState("Toutes");
  const [bankFilter, setBankFilter] = useState("Toutes");

  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => {
      setSession(data.session);
      if (data.session) loadLines();
    });

    const { data: listener } = supabase.auth.onAuthStateChange((_event, nextSession) => {
      setSession(nextSession);
      if (nextSession) loadLines();
    });

    return () => listener.subscription.unsubscribe();
  }, []);

  async function signIn(event) {
    event.preventDefault();
    setMessage("Connexion...");

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      setMessage("Erreur connexion : " + error.message);
      return;
    }

    setMessage("Connecté ✅");
  }

  async function loadLines() {
    const { data, error } = await supabase
      .from("bank_statement_lines")
      .select("*")
      .order("operation_date", { ascending: false });

    if (error) {
      setMessage("Erreur lecture banque : " + error.message);
      return;
    }

    setLines(data || []);
  }

  const categories = useMemo(() => {
    return ["Toutes", ...Array.from(new Set(lines.map((line) => line.detected_category || "Non classé"))).sort()];
  }, [lines]);

  const banks = useMemo(() => {
    return ["Toutes", ...Array.from(new Set(lines.map((line) => line.bank_name || "Banque inconnue"))).sort()];
  }, [lines]);

  const filteredLines = useMemo(() => {
    return lines.filter((line) => {
      const okCategory = categoryFilter === "Toutes" || (line.detected_category || "Non classé") === categoryFilter;
      const okBank = bankFilter === "Toutes" || (line.bank_name || "Banque inconnue") === bankFilter;
      return okCategory && okBank;
    });
  }, [lines, categoryFilter, bankFilter]);

  const summary = useMemo(() => summarize(filteredLines), [filteredLines]);
  const byCategory = useMemo(() => groupByCategory(filteredLines), [filteredLines]);
  const unclassified = useMemo(() => {
    return filteredLines.filter((line) =>
      (line.detected_category || "").toLowerCase().includes("classer") ||
      (Number(line.confidence) || 0) < 0.55
    );
  }, [filteredLines]);

  if (!session) {
    return (
      <div className="bankPage">
        <div className="loginCard">
          <p className="eyebrow">Tibaldo OS</p>
          <h1>Reporting banque</h1>
          <p>Connexion privée pour consulter les relevés bancaires analysés.</p>

          <form onSubmit={signIn}>
            <label>
              Email
              <input value={email} onChange={(event) => setEmail(event.target.value)} />
            </label>

            <label>
              Mot de passe
              <input type="password" value={password} onChange={(event) => setPassword(event.target.value)} />
            </label>

            <button>Se connecter</button>
          </form>

          {message && <p className="message">{message}</p>}
        </div>

        <style>{styles}</style>
      </div>
    );
  }

  return (
    <div className="bankPage">
      <header className="hero">
        <div>
          <p className="eyebrow">Tibaldo OS</p>
          <h1>Reporting banque</h1>
          <p>Analyse des relevés importés : entrées, sorties, catégories, charges fixes et opérations à classer.</p>
        </div>

        <button className="secondary" onClick={loadLines}>Rafraîchir</button>
      </header>

      {message && <p className="message">{message}</p>}

      <section className="filters">
        <label>
          Banque
          <select value={bankFilter} onChange={(event) => setBankFilter(event.target.value)}>
            {banks.map((bank) => <option key={bank}>{bank}</option>)}
          </select>
        </label>

        <label>
          Catégorie
          <select value={categoryFilter} onChange={(event) => setCategoryFilter(event.target.value)}>
            {categories.map((category) => <option key={category}>{category}</option>)}
          </select>
        </label>

        <button className="danger" onClick={() => {
          setBankFilter("Toutes");
          setCategoryFilter("Toutes");
        }}>
          Reset filtres
        </button>
      </section>

      <section className="kpiGrid">
        <Kpi icon="📄" label="Opérations" value={String(filteredLines.length)} />
        <Kpi icon="🟢" label="Revenus pro réels" value={formatCurrency(summary.realIncome)} />
        <Kpi icon="🔴" label="Sorties totales" value={formatCurrency(summary.expense)} />
        <Kpi icon="🚫" label="Virements exclus" value={formatCurrency(summary.transfersOut + summary.transfersIn)} />
        <Kpi icon="✅" label="Sorties réelles pro" value={formatCurrency(summary.realExpense)} />
        <Kpi icon="⚖️" label="Solde réel estimé" value={formatCurrency(summary.realNet)} />
        <Kpi icon="🏠" label="Airbnb reçu" value={formatCurrency(summary.airbnb)} />
        <Kpi icon="📌" label="Charges fixes" value={formatCurrency(summary.fixedCharges)} />
        <Kpi icon="🧾" label="À classer" value={String(unclassified.length)} />
      </section>

      <section className="incomeGrid">
        <IncomeCard title="Airbnb" value={summary.revenueAirbnb} />
        <IncomeCard title="Plantes" value={summary.revenuePlants} />
        <IncomeCard title="Petsitting" value={summary.revenuePetsitting} />
        <IncomeCard title="Autres revenus pro" value={summary.revenueOther} />
      </section>

      <section className="split">
        <article className="panel">
          <p className="eyebrow">Répartition</p>
          <h2>Par catégorie</h2>

          <div className="categoryList">
            {Object.entries(byCategory)
              .sort((a, b) => Math.abs(b[1].net) - Math.abs(a[1].net))
              .map(([category, data]) => (
                <div className="categoryRow" key={category}>
                  <div>
                    <strong>{category}</strong>
                    <small>{data.count} opération(s)</small>
                  </div>
                  <div className="amounts">
                    <span>{formatCurrency(data.income)}</span>
                    <span>{formatCurrency(data.expense)}</span>
                    <b>{formatCurrency(data.net)}</b>
                  </div>
                </div>
              ))}
          </div>

          {!Object.keys(byCategory).length && <p>Aucune donnée bancaire pour le moment.</p>}
        </article>

        <article className="panel">
          <p className="eyebrow">Contrôle</p>
          <h2>Opérations à vérifier</h2>

          <div className="checkList">
            {unclassified.slice(0, 12).map((line) => (
              <div className="checkRow" key={line.id}>
                <strong>{line.clean_label || line.raw_label}</strong>
                <span>{line.operation_date || "—"} · {formatCurrency(line.amount)}</span>
                <small>{line.detected_category || "Non classé"} · confiance {Math.round((Number(line.confidence) || 0) * 100)}%</small>
              </div>
            ))}
          </div>

          {!unclassified.length && <p>Aucune opération urgente à classer ✅</p>}
        </article>
      </section>

      <section className="tableCard">
        <h2>Détail des opérations</h2>

        <div className="tableWrap">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Banque</th>
                <th>Libellé</th>
                <th>Catégorie</th>
                <th>Entrée</th>
                <th>Sortie</th>
                <th>Net</th>
                <th>Pro ?</th>
              </tr>
            </thead>
            <tbody>
              {filteredLines.map((line) => (
                <tr key={line.id}>
                  <td>{line.operation_date || "—"}</td>
                  <td>{line.bank_name || "—"}</td>
                  <td>{line.clean_label || line.raw_label}</td>
                  <td>{line.detected_category || "Non classé"}</td>
                  <td>{line.amount_in ? formatCurrency(line.amount_in) : "—"}</td>
                  <td>{line.amount_out ? formatCurrency(line.amount_out) : "—"}</td>
                  <td>{formatCurrency(line.amount)}</td>
                  <td>{line.is_professional === true ? "Oui" : line.is_professional === false ? "Non" : "À vérifier"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {!filteredLines.length && <p>Aucune ligne bancaire importée.</p>}
      </section>

      <style>{styles}</style>
    </div>
  );
}

function IncomeCard({ title, value }) {
  return (
    <article className="incomeCard">
      <p>{title}</p>
      <strong>{formatCurrency(value)}</strong>
    </article>
  );
}

function Kpi({ icon, label, value }) {
  return (
    <article className="kpi">
      <span>{icon}</span>
      <p>{label}</p>
      <strong>{value}</strong>
    </article>
  );
}

function summarize(lines) {
  const fixedCategories = [
    "Crédits",
    "Assurances",
    "Énergie",
    "Télécom",
    "Impôts",
    "Immobilier",
    "Frais bancaires",
  ];

  return lines.reduce(
    (acc, line) => {
      const income = Number(line.amount_in) || 0;
      const expense = Number(line.amount_out) || 0;
      const amount = Number(line.amount) || 0;
      const category = String(line.detected_category || "");
      const normalizedCategory = category.toLowerCase();
      const isTransfer = !!line.is_transfer;

      acc.income += income;
      acc.expense += expense;
      acc.net += amount;

      if (isTransfer) {
        acc.transfersOut += expense;
        acc.transfersIn += income;
      } else {
        acc.realExpense += expense;
        acc.realIncome += income;
      }

      acc.realNet = acc.realIncome - acc.realExpense;

      if (!isTransfer && income > 0) {
        if (normalizedCategory.includes("airbnb")) {
          acc.airbnb += income;
          acc.revenueAirbnb += income;
        } else if (normalizedCategory.includes("plantes")) {
          acc.revenuePlants += income;
        } else if (normalizedCategory.includes("petsitting")) {
          acc.revenuePetsitting += income;
        } else {
          acc.revenueOther += income;
        }
      }

      if (!isTransfer && fixedCategories.includes(category)) {
        acc.fixedCharges += expense;
      }

      if (!isTransfer && expense > 0 && !fixedCategories.includes(category)) {
        acc.variableExpense += expense;
      }

      return acc;
    },
    {
      income: 0,
      expense: 0,
      net: 0,
      realIncome: 0,
      realExpense: 0,
      realNet: 0,
      transfersIn: 0,
      transfersOut: 0,
      airbnb: 0,
      revenueAirbnb: 0,
      revenuePlants: 0,
      revenuePetsitting: 0,
      revenueOther: 0,
      fixedCharges: 0,
      variableExpense: 0,
    }
  );
}

function groupByCategory(lines) {
  const grouped = {};

  lines.forEach((line) => {
    const category = line.detected_category || "Non classé";

    if (!grouped[category]) {
      grouped[category] = { income: 0, expense: 0, net: 0, count: 0 };
    }

    grouped[category].income += Number(line.amount_in) || 0;
    grouped[category].expense += Number(line.amount_out) || 0;
    grouped[category].net += Number(line.amount) || 0;
    grouped[category].count += 1;
  });

  return grouped;
}

function formatCurrency(value) {
  return (Number(value) || 0).toLocaleString("fr-FR", {
    style: "currency",
    currency: "EUR",
  });
}

const styles = `
* { box-sizing: border-box; }

body { margin: 0; }

.bankPage {
  min-height: 100vh;
  padding: 16px;
  background:
    radial-gradient(circle at top left, rgba(126,226,168,.16), transparent 34%),
    radial-gradient(circle at bottom right, rgba(255,209,102,.20), transparent 36%),
    linear-gradient(135deg, #f7f4ef 0%, #eef8f2 100%);
  color: #1f4d3a;
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.loginCard,
.hero,
.filters,
.panel,
.tableCard {
  width: min(1180px, 100%);
  margin: 0 auto 14px;
  background: rgba(255,255,255,.9);
  border: 1px solid rgba(31,77,58,.10);
  border-radius: 28px;
  padding: 20px;
  box-shadow: 0 18px 44px rgba(31,77,58,.08);
}

.loginCard {
  max-width: 460px;
  margin-top: 8vh;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
}

.eyebrow {
  margin: 0 0 8px;
  text-transform: uppercase;
  color: #8a6a4f;
  letter-spacing: .13em;
  font-size: 11px;
  font-weight: 950;
}

h1 {
  margin: 0 0 10px;
  font-size: clamp(36px, 7vw, 62px);
  line-height: .95;
}

h2 { margin: 0 0 14px; }

p {
  color: #6d6257;
  line-height: 1.45;
}

button {
  border: 0;
  cursor: pointer;
  font: inherit;
}

.loginCard button,
.secondary {
  border-radius: 18px;
  padding: 13px 16px;
  font-weight: 950;
  background: #1f4d3a;
  color: white;
}

.danger {
  border-radius: 18px;
  padding: 13px 16px;
  font-weight: 950;
  background: #ffe6e6;
  color: #a52626;
  align-self: end;
}

label {
  display: grid;
  gap: 8px;
  margin: 0;
  color: #1f4d3a;
  font-weight: 950;
}

input,
select {
  width: 100%;
  border: 1px solid rgba(31,77,58,.16);
  border-radius: 18px;
  padding: 14px;
  font: inherit;
  background: white;
  color: #1f4d3a;
}

.message {
  width: min(1180px, 100%);
  margin: 0 auto 14px;
  background: white;
  border-radius: 18px;
  padding: 12px 14px;
  color: #1f4d3a;
  font-weight: 850;
}

.filters {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

.kpiGrid {
  width: min(1180px, 100%);
  margin: 0 auto 14px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.kpi {
  background: rgba(255,255,255,.9);
  border-radius: 24px;
  padding: 18px;
  box-shadow: 0 14px 34px rgba(31,77,58,.07);
}

.kpi span {
  display: block;
  font-size: 24px;
  margin-bottom: 8px;
}

.kpi p {
  margin: 0 0 8px;
  color: #8a6a4f;
  text-transform: uppercase;
  letter-spacing: .09em;
  font-size: 11px;
  font-weight: 950;
}

.kpi strong {
  display: block;
  font-size: 22px;
  color: #1f4d3a;
}

.split {
  width: min(1180px, 100%);
  margin: 0 auto 14px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
}

.categoryList,
.checkList {
  display: grid;
  gap: 10px;
}

.categoryRow,
.checkRow {
  background: #f7f4ef;
  border-radius: 18px;
  padding: 14px;
}

.categoryRow {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
}

.categoryRow small,
.checkRow small {
  display: block;
  color: #8a6a4f;
  font-weight: 800;
  margin-top: 4px;
}

.amounts {
  text-align: right;
  display: grid;
  gap: 3px;
}

.amounts span {
  color: #6d6257;
  font-size: 13px;
}

.amounts b {
  color: #1f4d3a;
}

.checkRow strong {
  display: block;
  color: #1f4d3a;
}

.checkRow span {
  display: block;
  color: #6d6257;
  margin-top: 4px;
}

.tableWrap {
  overflow: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 1050px;
}

th,
td {
  text-align: left;
  border-bottom: 1px solid rgba(31,77,58,.10);
  padding: 12px 10px;
  vertical-align: top;
}

th {
  color: #8a6a4f;
  text-transform: uppercase;
  letter-spacing: .07em;
  font-size: 11px;
}

td {
  color: #1f4d3a;
  font-weight: 720;
}

@media (min-width: 760px) {
  .filters {
    grid-template-columns: 1fr 1fr 180px;
  }

  .kpiGrid {
    grid-template-columns: repeat(3, 1fr);
  }

  .incomeGrid {
    grid-template-columns: repeat(4, 1fr);
  }

  .split {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 760px) {
  .hero {
    flex-direction: column;
  }

  .secondary,
  .danger {
    width: 100%;
  }
}
`;

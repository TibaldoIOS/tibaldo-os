  color: #6d6257;
  font-size: 13px;
}

.buttonRow {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.alignBottom {
  align-items: end;
}

.housekeepingDashboard {
  display: grid;
  gap: 14px;
}

.filtersPanel {
  display: grid;
  gap: 12px;
  background: #f7f4ef;
  border-radius: 20px;
  padding: 14px;
}

.wideFilter {
  grid-column: 1 / -1;
}

.kpiGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.kpiCard {
  background: #f7f4ef;
  border-radius: 20px;
  padding: 14px;
}

.kpiCard span {
  font-size: 24px;
}

.kpiCard p {
  color: #8a6a4f;
  margin: 8px 0 4px;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.kpiCard strong {
  color: #1f4d3a;
  font-size: 22px;
}

.dashboardSplit {
  display: grid;
  gap: 12px;
}

.miniDashboard {
  background: #f7f4ef;
  border-radius: 20px;
  padding: 14px;
}

.alertItem {
  background: #fff4e6;
}

.purchaseList {
  margin-top: 12px;
}

.tableWrap {
  overflow-x: auto;
  background: #f7f4ef;
  border-radius: 20px;
  padding: 14px;
}

.dataTable {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.dataTable th, .dataTable td {
  text-align: left;
  padding: 10px;
  border-bottom: 1px solid rgba(31,77,58,.12);
  white-space: nowrap;
  vertical-align: top;
}

.dataTable th {
  color: #1f4d3a;
  font-weight: 900;
}

.detectedColumns {
  background: #f7f4ef;
  border-radius: 20px;
  padding: 14px;
}

.fileButton {
  margin: 0;
  display: inline-grid;
  place-items: center;
  background: #1f4d3a;
  color: white;
  border-radius: 16px;
  padding: 14px 16px;
  font-weight: 900;
  min-width: 130px;
  text-align: center;
}

.fileButton input {
  display: none;
}

@media (min-width: 900px) {
  .topHeader {
    max-width: 980px;
    margin: 0 auto;
  }

  .topNav {
    max-width: 780px;
    margin: 0 auto;
    border-radius: 0 0 24px 24px;
  }

  .content {
    padding: 26px;
  }

  .page {
    gap: 20px;
  }

  .hero, .card, .progressCard {
    padding: 26px;
  }

  .historyItem {
    grid-template-columns: 180px 1fr;
    align-items: center;
  }

  .chart svg {
    height: 260px;
  }

  .filtersPanel {
    grid-template-columns: repeat(3, 1fr);
  }

  .kpiGrid {
    grid-template-columns: repeat(4, 1fr);
  }

  .dashboardSplit {
    grid-template-columns: 1fr 1fr;
  }
}
